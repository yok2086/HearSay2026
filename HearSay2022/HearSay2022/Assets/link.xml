<!-- Stops IL2CPP managed code stripping from removing code the SSH/MQTT
     libraries only reach via reflection (crypto algorithms, MQTT adapters,
     JSON converters). Needed for HearSaySshMqttManager on Android. -->
<linker>
  <assembly fullname="Renci.SshNet" preserve="all"/>
  <assembly fullname="BouncyCastle.Cryptography" preserve="all"/>
  <assembly fullname="MQTTnet" preserve="all"/>
  <assembly fullname="Newtonsoft.Json" preserve="all"/>
  <assembly fullname="System.Formats.Asn1" preserve="all"/>
  <assembly fullname="Microsoft.Bcl.AsyncInterfaces" preserve="all"/>
</linker>
